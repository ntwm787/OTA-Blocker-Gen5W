[nemesis]
version=1.1
id=gen5w.ota-blocker
name=OTA Blocker
package-version=1.0.0
type=application
short-desc="Blocks OTAClient connections through its app-local offline mode."
detailed-desc="Patches OTAClient's offline-mode check so the app rejects Red Bend network connections. Requires 260507 build and exact OTA file hashes. Uninstall restores the original. Independent modem OTA blocking and USB-update compatibility are unverified."
os=NEEV*.260507
models=neev*
depends="!hmgapi"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
